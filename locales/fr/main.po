msgid "Mark as opened"
msgstr "Ouvrir"

msgid "Mark as closed"
msgstr "Fermer"

msgid "Delete all comments"
msgstr "Supprimer tous les commentaires"

msgid "Delete all trackbacks"
msgstr "Supprimer tous les rétroliens"

msgid "Comments successfully opened."
msgstr "Commentaires ouverts avec succès."

msgid "Comments successfully closed."
msgstr "Commentaires fermés avec succès."

msgid "Delete posts comments"
msgstr "Supprimer les commentaires des billets"

msgid "Are you sure you want to delete all comments?"
msgstr "Êtes-vous sûr de vouloir supprimer tous les commentaires ?"

msgid "Comments successfully deleted."
msgstr "Commentaires supprimés avec succès."

msgid "Trackbacks successfully opened."
msgstr "Rétroliens ouverts avec succès."

msgid "Trackbacks successfully closed."
msgstr "Rétroliens fermés avec succès."

msgid "Delete posts trackbacks"
msgstr "Supprimer les rétroliens des billets"

msgid "Are you sure you want to delete all trackbacks?"
msgstr "Êtes-vous sûr de vouloir supprimer tous les rétroliens ?"

msgid "Trackbacks successfully deleted."
msgstr "Rétroliens supprimés avec succès."


msgid "One trackback, whatever its status, will be permanently deleted."
msgid_plural "%d trackbacks, whatever their status, will be permanently deleted."
msgstr[0] "Un rétrolien, quel que soit son statut, sera définitivement supprimé."
msgstr[1] "%d rétroliens, quel que soit leur statut, seront définitivement supprimés."

msgid "One comment, whatever its status, will be permanently deleted."
msgid_plural "%d comments, whatever their status, will be permanently deleted."
msgstr[0] "Un commentaire, quel que soit son statut, sera définitivement supprimé."
msgstr[1] "%d commentaires, quel que soit leur statut, seront définitivement supprimés."

msgid "I confirm this deletion"
msgstr "Je confirme cette suppression"
